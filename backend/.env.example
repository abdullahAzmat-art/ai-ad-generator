PORT=4000
FIRECRAWL_API_KEY=
SCRAPERAPI_KEY=
# Groq fallback — used automatically when OpenRouter fails or runs out of credits
GROQ_API_KEY=
# Fallback models per node tier
# Strong tier — blueprint, draft (default: openai/gpt-oss-120b)
GROQ_MODEL_STRONG=
# Fast tier — detect/classify/extract (default: openai/gpt-oss-20b)
GROQ_MODEL_FAST=

# Mock pipeline data — 1 = scrape/classify/detect/blueprint/pexels/draft return
# canned product-ad data (no Firecrawl/LLM spend); 0 = real APIs
USE_MOCK_DATA=0
# Mock the render node too — 1 = skip the real JSON2Video API call and return a
# fake video URL; 0 = submit to JSON2Video (requires JSON2VIDEO_API_KEY)
DEV_MOCK_RENDER=0

# Background music for rendered ads — direct MP3 URL, downloaded by JSON2Video.
# Leave empty to use the default soft piano/strings track (Pixabay, free for
# commercial use, no attribution required)
BACKGROUND_MUSIC_URL=
